# ─────────────────────────────────────────────────────────────────────────────
# RENTDZ — configuration
# Copy to .env and fill in. NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=RENTDZ
APP_ENV=development                 # development | production
APP_URL=http://127.0.0.1:8000       # public base URL (https:// in production)
HOST=127.0.0.1
PORT=8000
DEBUG=true                          # MUST be false in production

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite path (default). The file is created automatically.
DATABASE_URL=sqlite:///storage/db/rentdz.db

# ── Security (REQUIRED in production) ────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
SESSION_TTL_HOURS=72
COOKIE_SECURE=false                 # true in production (HTTPS only)
PASSWORD_MIN_LEN=10
PBKDF2_ITERATIONS=260000
MAX_LOGIN_ATTEMPTS=8
LOCKOUT_MINUTES=15
RATE_LIMIT_ENABLED=true

# ── Localisation (Algeria defaults) ──────────────────────────────────────────
DEFAULT_LOCALE=fr                   # fr | ar | en
CURRENCY=DZD
TIMEZONE=Africa/Algiers

# ── Uploads ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=8
MAX_REQUEST_MB=12

# ── Demo data ────────────────────────────────────────────────────────────────
DEMO_MODE=true                      # false in production; blocks `manage.py seed`

# ── E-mail (transactional) ───────────────────────────────────────────────────
# Until configured, messages are queued in the outbox and marked
# "unconfigured" — the app never claims a mail was sent.
EMAIL_PROVIDER=log                  # log | smtp | api
EMAIL_FROM=no-reply@rentdz.dz
EMAIL_FROM_NAME=RENTDZ
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_API_KEY=

# ── SMS / WhatsApp ───────────────────────────────────────────────────────────
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER=RENTDZ
WHATSAPP_API_KEY=

# ── Maps ─────────────────────────────────────────────────────────────────────
MAPS_PROVIDER=osm                   # osm (no key needed) | google | mapbox
MAPS_API_KEY=

# ── Payments ─────────────────────────────────────────────────────────────────
# Offline methods (cash on pickup, bank transfer) work out of the box.
# Online providers stay disabled until their credentials are present, and
# will refuse to process rather than fake a successful payment.
#
# SATIM gateway — CIB and Edahabia cards (requires a merchant contract
# with your Algerian bank or Algérie Poste):
PAYMENT_SATIM_MERCHANT_ID=
PAYMENT_SATIM_API_KEY=
PAYMENT_SATIM_WEBHOOK_SECRET=
# Stripe — international cards:
PAYMENT_STRIPE_KEY=
PAYMENT_STRIPE_WEBHOOK_SECRET=
# PayPal — useful for the diaspora:
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── File storage ─────────────────────────────────────────────────────────────
STORAGE_DRIVER=local                # local | s3
S3_BUCKET=
S3_KEY=
S3_SECRET=
